<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ACP Inspector: third-party licenses</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; }
  h1 { font-size: 1.5rem; }
  h2 { font-size: 1.15rem; margin-top: 2.5rem; }
  ul.used-by { columns: 3 12rem; padding-left: 1.2rem; }
  pre { white-space: pre-wrap; font-size: 12px; padding: 1rem; border: 1px solid #8884; border-radius: 6px; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>ACP Inspector is distributed under the MIT or Apache-2.0 license. It is built from the open-source Rust crates listed below, under the licenses that follow.</p>

<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>

{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul class="used-by">
{{#each used_by}}
  <li>{{crate.name}} {{crate.version}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
