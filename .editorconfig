root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.nix]
indent_size = 2

# The web toolchains' own default, and what the Tailwind stylesheets and
# Playwright suites in `app/` and `demo/` are already written in.
[{*.css,*.ts,*.mjs,*.json}]
indent_size = 2

[*.toml]
indent_size = 2

[{*.yml,*.yaml}]
indent_size = 2

[*.dang]
indent_size = 2
